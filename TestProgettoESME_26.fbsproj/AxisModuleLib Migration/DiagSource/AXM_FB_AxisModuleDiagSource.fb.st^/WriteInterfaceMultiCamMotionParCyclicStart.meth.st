__DECLARATION__
{attribute 'conditionalshow_all_locals'}
METHOD INTERNAL WriteInterfaceMultiCamMotionParCyclicStart : BOOL
VAR_INPUT
END_VAR
VAR_OUTPUT
	q_etDiag		: GD.ET_Diag;
	q_etDiagExt	: TPL.ET_DiagExt;
	q_sMsg			: STRING[80];
END_VAR
__IMPLEMENTATION__
THIS^.fbTreeWriter.NodeStart(	i_sName		:= Standard.CONCAT('iq_astMotionPar[', Standard.CONCAT(DINT_TO_STRING(THIS^.diMotionParCounter), ']')),
								q_etDiag	=> q_etDiag,
								q_etDiagExt	=> q_etDiagExt,
								q_sMsg		=> q_sMsg);
								
IF q_etDiag <> GD.ET_Diag.Ok THEN
	RETURN;
END_IF	
								
	THIS^.fbTreeWriter.Parameter(	i_sName		:= 'diNumberOfCamPoints', 
									i_sValue	:= DINT_TO_STRING(THIS^.pstInterface^.stMultiCam.iq_astMotionPar[THIS^.diMotionParCounter].diNumberOfCamPoints),
									q_etDiag	=> q_etDiag,
									q_etDiagExt	=> q_etDiagExt,
									q_sMsg		=> q_sMsg);
							
	IF q_etDiag <> GD.ET_Diag.Ok THEN
		RETURN;
	END_IF	
	
	THIS^.fbTreeWriter.Parameter(	i_sName		:= 'diUserTableId', 
									i_sValue	:= DINT_TO_STRING(THIS^.pstInterface^.stMultiCam.iq_astMotionPar[THIS^.diMotionParCounter].diUserTableId),
									q_etDiag	=> q_etDiag,
									q_etDiagExt	=> q_etDiagExt,
									q_sMsg		=> q_sMsg);
							
	IF q_etDiag <> GD.ET_Diag.Ok THEN
		RETURN;
	END_IF	
	
	THIS^.fbTreeWriter.Parameter(	i_sName		:= 'lrYPeriod', 
									i_sValue	:= LREAL_TO_STRING(THIS^.pstInterface^.stMultiCam.iq_astMotionPar[THIS^.diMotionParCounter].lrYPeriod),
									q_etDiag	=> q_etDiag,
									q_etDiagExt	=> q_etDiagExt,
									q_sMsg		=> q_sMsg);
							
	IF q_etDiag <> GD.ET_Diag.Ok THEN
		RETURN;
	END_IF	
