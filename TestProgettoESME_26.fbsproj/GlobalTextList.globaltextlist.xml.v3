    <Single Type="{53da1be7-ad25-47c3-b0e8-e26286dad2e0}" Method="IArchivable">
      <Single Name="TextID" Type="string">4513</Single>
      <Single Name="TextDefault" Type="string">(* AxisModule command area: 1-199 *)

(*Selecting OpModes of FB_AxisModule*)
Homing			:= 10
Manual			:= 20
CamCs			:= 30
CamWs			:= 31
Endless			:= 40
Positioning		:= 50
BrakeRelease		:= 70
AdditionalCs		:= 80
AdditionalWs		:= 81

(*ControlSignals for the selected OpMode of FB_AxisModule*)
Start			:= 100
StartTrig			:= 101
StartTrigWaitInPos	:= 102
Stop			:= 110
Hold			:= 120
WsStart			:= 150

(*De-/Activating PositionControl of the respective Drive*)
DriveEnableOn		:= 130
DriveEnableOff		:= 140</Single>
      <List Name="LanguageTexts" Type="System.Collections.ArrayList" />
    </Single>
    <Single Type="{53da1be7-ad25-47c3-b0e8-e26286dad2e0}" Method="IArchivable">
      <Single Name="TextID" Type="string">1755</Single>
      <Single Name="TextDefault" Type="string">+</Single>
      <List Name="LanguageTexts" Type="System.Collections.ArrayList" />
    </Single>
    <Single Type="{53da1be7-ad25-47c3-b0e8-e26286dad2e0}" Method="IArchivable">
      <Single Name="TextID" Type="string">1748</Single>
      <Single Name="TextDefault" Type="string">-</Single>
      <List Name="LanguageTexts" Type="System.Collections.ArrayList" />
    </Single>
    <Single Type="{53da1be7-ad25-47c3-b0e8-e26286dad2e0}" Method="IArchivable">
      <Single Name="TextID" Type="string">759</Single>
      <Single Name="TextDefault" Type="string">0 - Drive is not ready or is ramping down (e.g. ControllerEnable = "off / FALSE", diagnosis message with reaction B active)
1 - Power unit ready, drive is torque-free, waiting for enable
2 - Drive is switched on, waiting for brake to be released
3 - Waiting for job
4 - Waiting for start
5 - Processing master job
6 - Processing master-slave job
7 - Canceling jobs, drive stopping
8 - Job processing blocked, drive stopped</Single>
      <List Name="LanguageTexts" Type="System.Collections.ArrayList" />
    </Single>
