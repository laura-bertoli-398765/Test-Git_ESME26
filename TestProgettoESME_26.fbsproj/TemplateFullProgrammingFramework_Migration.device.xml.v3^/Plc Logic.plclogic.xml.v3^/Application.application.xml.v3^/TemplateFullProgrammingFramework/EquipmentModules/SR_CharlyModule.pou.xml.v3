  <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
    <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
      <Single Name="TextBlobForSerialisation" Type="string">PROGRAM SR_CharlyModule

VAR CONSTANT
(* Standard related constants *)
	c_udiNumberOfGroups				: UDINT := 3;			(* Maximum number of groups *)
	c_udiNumberOfGroupMembers		: UDINT := 10;			(* Maximum number of members per group *)

	c_udiNumberOfCmdTables			: UDINT := 8;			(* Must be the exact number of used CMDTables! *)
	c_udiNumberOfCmdSteps			: UDINT := 16;			(* Make sure that the number of commands/ Steps  that each table
																   contains does not exceed the c_diNumberOfCMDSteps variable.*)

(* Definition group of modules *)
	c_udiCharlyGroup1				: UDINT := 2001;		(* Name of module group  1 *)
	c_udiCharlyGroup2				: UDINT := 2002;		(* Name of module group  2 *)

(* System generated code, could be modified for your application *)
	c_udiNumberOfSubModules			: UDINT := 3;			(* Number of SubModules *)
	c_udiSlave3						: UDINT := 1;
	c_udiSlave4						: UDINT := 2;
	c_udiNocke1						: UDINT := 3;
(* End of system generated code, could be modified for your application *)
END_VAR

VAR (* User specific variables *)
	stSlave3Interface				: AXM_ST_ModuleInterface;
	fbSlave3Module					: AXM_FB_AxisModule;
	
	stSlave4Interface				: AXM_ST_ModuleInterface;
	fbSlave4Module					: AXM_FB_AxisModule;

	fbAxisModuleController			: AXM_FB_AxisModuleController;

	stNocke1Interface				: ST_ExampleLeafModuleInterface;
	fbNocke1Module					: FB_ExampleLeafModule;

	fbExampleLeafModuleController	: FB_ExampleLeafModuleController;

	xFirstCall						: BOOL := TRUE;
	iPosState						: INT := 1;
END_VAR

VAR_INPUT
(* Master of AlphaModule *)
	i_ifMaster						: MOIN.IF_Axis;
END_VAR

VAR_IN_OUT
(* TPL.ST_StandardModuleInterface *)	
	iq_stStandardModuleItf			: TPL.ST_StandardModuleInterface;
	
(* TPL.ST_StandardMotionInterface *)		
	iq_stStandardMotionItf			: TPL.ST_StandardMotionInterface;
	
(* ExceptionHandling and Logging *)	
	iq_stExceptionList				: TPL.ST_ExceptionList;
	iq_stLogDataList				: TPL.ST_LogDataList;
END_VAR

VAR
	xInitSuccessful : BOOL := TRUE;
	
(* Standard related variables *)
	astSubModuleInterface			: ARRAY[1..c_udiNumberOfSubModules] OF TPL.ST_StandardModuleInterface;		(* Interface to modules *)
	aaudiSubModuleGroups			: ARRAY[1..c_udiNumberOfGroups,1..c_udiNumberOfGroupMembers] OF UDINT;
	adwSubModuleAddInterfaces		: ARRAY[1..c_udiNumberOfSubModules] OF TPL.TYPE_ADDRESS; // change DWORD to ADDRESS

(* Modules related variables *)
	fbModuleController				: TPL.FB_ModuleController;
	etDiagModuleController			: GD.ET_Diag;
	etDiagExtModuleController		: TPL.ET_DiagExt;
	sMsgModuleController			: STRING[80];
	xWaitForStartStep				: BOOL;

	astListOfCmdTables				: ARRAY [1..c_udiNumberOfCmdTables] OF TPL.ST_CmdTable;
	udiTableIndex					: UDINT;
	udiStepIndex					: UDINT;
	diStep							: DINT;

	astPrepareTable					: ARRAY [1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd;		(* Relating  Cmd table *)
	astAutoTable					: ARRAY [1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd;		(* Relating  Cmd table *)
	astManualTable					: ARRAY [1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd;		(* Relating  Cmd table *)
	astHoldTable					: ARRAY [1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd;		(* Relating  Cmd table *)
	astStartTable					: ARRAY [1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd;		(* Relating  Cmd table *)
	astStopTable					: ARRAY [1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd;		(* Relating  Cmd table *)
	astBrakeReleaseTable			: ARRAY [1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd;		(* Relating  Cmd table *)
	astAbortTable					: ARRAY [1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd;		(* Relating  Cmd table *)

(* ExceptionHandling related variables *)
	fbExceptionHandler				: TPL.FB_ExceptionHandler2;

	aetReactionTranslationMode		: ARRAY[1..c_udiNumberOfSubModules] OF TPL.ET_ReactionTranslationMode;
	aastReactionTranslationTable	: ARRAY[1..c_udiNumberOfSubModules,1..TPL.Gc_udiMaxNumberOfReactions] OF TPL.ST_Reaction;
	astReactionTranslationJobs		: ARRAY[1..c_udiNumberOfSubModules] OF TPL.ST_ReactionTranslationJobs;
	
(* Exception declaration *)
	stUserException1				: TPL.ST_Exception;
	stUserException2				: TPL.ST_Exception;
	xModuleUserException1			: BOOL;
	xModuleUserException2			: BOOL;
	
	stUpdateStructsException		: TPL.ST_Exception;
	xUpdateStructsException			: BOOL;
	
	stInitReactionsException		: TPL.ST_Exception;
	xInitReactionsException			: BOOL;
	
	stInitSubModulesException		: TPL.ST_Exception;
	xInitSubModulesException		: BOOL;
	
	stIsDriveVirtualException		: TPL.ST_Exception;
	xIsDriveVirtualException		: BOOL;
	
(* Logging related variables*)
	fbLogger						: TPL.FB_Logger;
	fbLoggerPoint					: APL.FB_LoggerPoint;

(* OnlineChange related variables *)
	fbDetectOnlineChange			: TPL.FB_DetectOnlineChange;
	xDetectOnlineChangeActive		: BOOL; 
	xDetectOnlineChangeReady		: BOOL; 
	etDetectOnlineChangeDiag		: GD.ET_Diag;
	etDetectOnlineChangeDiagExt		: TPL.ET_DiagExt; 
	sDetectOnlineChangeMsg			: STRING[80];
	
(* Init related variables *)		
	lrShaftRefDelay					: LREAL;
	diResult						: DINT;	
	
	xDriveIsVirtual					: BOOL;	

(* POU-Feedback related variables*)	
	etDiag			: GD.ET_Diag;
	etDiagExt		: ET_DiagExt;
	etDiagExtTPL	: TPL.ET_DiagExt;
	etDiagExtAXM	: AXM_ET_DiagExt;
	etDiagExtExampleLeaf	: ET_DiagExtExampleLeafModule;
	sMsgBuffer		: STRING[80];
END_VAR
</Single>
