	xEnableFlag : BOOL;
	
	udii : UDINT;
	
	xInitHomingDone : BOOL;
	xNotAbleToSetException : BOOL;

	etDiagBuffer		: GD.ET_Diag;
	etDiagExtBufferTPL	: TPL.ET_DiagExt;
	sDiagMsgBuffer		: STRING[80];
	
	xDiagQuitFlag : BOOL;
	
	
	xExceptionReactionOutsideRange		: BOOL;
	
	stExceptionInit						: TPL.ST_Exception;
