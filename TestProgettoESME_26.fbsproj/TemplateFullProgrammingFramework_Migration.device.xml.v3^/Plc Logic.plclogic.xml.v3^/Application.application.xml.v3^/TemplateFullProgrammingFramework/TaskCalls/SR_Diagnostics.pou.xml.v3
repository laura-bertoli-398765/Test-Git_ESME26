    <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
      <Single Name="TextBlobForSerialisation" Type="string">PROGRAM SR_Diagnostics
VAR
	fbDiagnosticsManager : TPL.FB_DiagnosticsManager;
	stComStructure 		 : TPL.ST_DiagnosticsManagerToDiagSource;
	
	stWarning 		: TPL.ST_Exception;
	etLastDiagExt	: TPL.ET_DiagExt := TPL.ET_DiagExt.Ok;

	(* Add the instances of your sources for diag data here *)
	fbTemplateStaticStructureDiagSource	: TPL.FB_TemplateStaticStructureDiagSource;
	fbExceptionListDiagSource			: TPL.FB_ExceptionListDiagSource;
	fbExceptionDelayListDiagSource		: TPL.FB_ExceptionDelayListDiagSource;
	fbLogDataListDiagSource				: TPL.FB_LogDataListDiagSource;	
	fbAxisModuleDiagSource				: AXM_FB_AxisModuleDiagSource;
	xPrintCamData						: BOOL := TRUE;
	fbApplicationLoggerDiagSource		: FB_ApplicationLoggerDiagSource;

	(* example diag sources *)
	fbExampleTableDiagSource			: FB_ExampleTableDiagSource;
	fbExampleTreeDiagSource				: FB_ExampleTreeDiagSource;
END_VAR
</Single>
