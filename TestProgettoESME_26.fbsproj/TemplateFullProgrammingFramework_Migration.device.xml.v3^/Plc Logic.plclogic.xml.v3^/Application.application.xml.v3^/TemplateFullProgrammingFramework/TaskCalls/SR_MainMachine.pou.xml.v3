  <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
    <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
      <Single Name="TextBlobForSerialisation" Type="string">PROGRAM SR_MainMachine
VAR CONSTANT
	c_udiNumberOfGroups       : UDINT := 3; (* Maximum number of groups *)
	c_udiNumberOfGroupMembers : UDINT := 3; (* Maximum number of members per group *)
	
	c_udiNumberOfCmdTables : UDINT := 10; (* Must be the exact number of used CMDTables! *)
	c_udiNumberOfCmdSteps  : UDINT := 16; (* Make sure that the number of command steps that each table
													   contains does not exceed the c_udiNumberOfCmdSteps variable.*)
	
	(* Definition group of modules *)
	c_udiMasterGroup : UDINT := 2001; (* Name of module group  1 *)
	c_udiSlaveGroup  : UDINT := 2002; (* Name of module group  2 *)
	
	(* ModuleId of MainMachine *)
	c_udiMainModuleId : UDINT := 1; (* ModuleId *)
	
	(* System generated code, could be modified for your application *)
	c_udiNumberOfSubModules : UDINT := 4; (* Number of SubModules *)
	c_udiAlpha              : UDINT := 1; (* Name &amp; number of Module 1 *)
	c_udiBravo              : UDINT := 2; (* Name &amp; number of Module 2 *)
	c_udiCharly             : UDINT := 3; (* Name &amp; number of Module 3 *)
	c_udiNodeWithoutMotion  : UDINT := 4; (* Name &amp; number of Module 4 *)
	
	c_dwModuleType     : DWORD      := TPL.ET_ModuleType.MachineModule;
	c_sModuleTypeName  : STRING[14] := 'MainMachine';
	c_udiModuleVersion : UDINT      := 1;
	(* End of system generated code, could be modified for your application *)
END_VAR

VAR (* User specific variables *)
	pTaskInfo : POINTER TO CmpIecTask.Task_Info2;
END_VAR

VAR
	xInitSuccessful : BOOL := TRUE;
	
	(*INPUT Variables*)
	xInputErrorQuit    : BOOL;
	xInputStart        : BOOL;
	xInputStop         : BOOL;
	xInputPrepare      : BOOL;
	xInputAuto         : BOOL;
	xInputManual       : BOOL;
	xInputJogMachine   : BOOL;
	xInputHold         : BOOL;
	xInputAbort        : BOOL;
	xInputProductsOk   : BOOL;
	xInputPowerOn      : BOOL;
	xInputPowerOff     : BOOL;
	xInputBrakeRelease : BOOL;
	xInputEmergency    : BOOL := TRUE;
	
	(* OUTPUT Variables *)
	xOutputPrepareActive    : BOOL;
	xOutputAutoActive       : BOOL;
	xOutputHoldActive       : BOOL;
	xOutputServiceActive    : BOOL;
	xOutputManualActive     : BOOL;
	xOutputJogMachineActive : BOOL;
	
	(* User Exceptions declaration *)
	stSystemException1 : TPL.ST_Exception;
	stSystemException2 : TPL.ST_Exception;
	stSystemException3 : TPL.ST_Exception;
	
	stEmergencyStopException    : TPL.ST_Exception;
	stContactorControlException : TPL.ST_Exception;
	
	stUpdateStructsException : TPL.ST_Exception;
	xUpdateStructsException  : BOOL;
	
	stInitReactionsException : TPL.ST_Exception;
	xInitReactionsException  : BOOL;
	
	stInitSubModulesException : TPL.ST_Exception;
	xInitSubModulesException  : BOOL;
	
	stUserException1 : TPL.ST_Exception;
	stUserException2 : TPL.ST_Exception;
	stUserException3 : TPL.ST_Exception;
	stUserException4 : TPL.ST_Exception;
	stUserException5 : TPL.ST_Exception;
	
