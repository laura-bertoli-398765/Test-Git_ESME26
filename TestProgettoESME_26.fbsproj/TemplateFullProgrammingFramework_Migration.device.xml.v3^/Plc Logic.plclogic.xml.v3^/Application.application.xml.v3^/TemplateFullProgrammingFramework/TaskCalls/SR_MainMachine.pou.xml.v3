	astAutoTable           : ARRAY[1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd; (* Relating  Cmd table *)
	astManualTable         : ARRAY[1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd; (* Relating  Cmd table *)
