	(* ApplicationLogger *)
	fbLoggerPoint : APL.FB_LoggerPoint;
	
	(* Main ModuleController *)
	fbModuleController        : TPL.FB_ModuleController;
	etDiagModuleController    : GD.ET_Diag;
	etDiagExtModuleController : TPL.ET_DiagExt;
	sMsgModuleController      : STRING[80];
	xWaitForStartStep         : BOOL;
	
	(* Standard related variables *)
	astSubModuleInterface     : ARRAY[1..c_udiNumberOfSubModules] OF TPL.ST_StandardModuleInterface; (* Standard Module interface *)
	aaudiSubModuleGroups      : ARRAY[1..c_udiNumberOfGroups, 1..c_udiNumberOfGroupMembers] OF UDINT;
	adwSubModuleAddInterfaces : ARRAY[1..c_udiNumberOfSubModules] OF DWORD;
	
	(* Machine interface *)
