	astAbortTable          : ARRAY[1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd; (* Relating  Cmd table *)
	astJogMachineTable     : ARRAY[1..c_udiNumberOfCmdSteps] OF TPL.ST_Cmd; (* Relating  Cmd table *)
	
	(* ExceptionHandling related variables *)
