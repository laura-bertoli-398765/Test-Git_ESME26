	aetReactionTranslationMode   : ARRAY[1..c_udiNumberOfSubModules] OF TPL.ET_ReactionTranslationMode;
	aastReactionTranslationTable : ARRAY[1..c_udiNumberOfSubModules, 1..TPL.Gc_udiMaxNumberOfReactions] OF TPL.ST_Reaction;
	astReactionTranslationJobs   : ARRAY[1..c_udiNumberOfSubModules] OF TPL.ST_ReactionTranslationJobs;
	
	xCheckExceptionList : BOOL := TRUE;
