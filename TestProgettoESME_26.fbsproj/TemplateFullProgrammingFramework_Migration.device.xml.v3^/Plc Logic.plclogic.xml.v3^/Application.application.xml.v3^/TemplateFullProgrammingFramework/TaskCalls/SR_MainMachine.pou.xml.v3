	sSetExceptionMsg2 : STRING[80];
	sSetExceptionMsg3 : STRING[80];
	sSetExceptionMsg4 : STRING[80];
	sSetExceptionMsg5 : STRING[80];
	
	(* OPM control Variables *)
	xActPrepare    : BOOL;
