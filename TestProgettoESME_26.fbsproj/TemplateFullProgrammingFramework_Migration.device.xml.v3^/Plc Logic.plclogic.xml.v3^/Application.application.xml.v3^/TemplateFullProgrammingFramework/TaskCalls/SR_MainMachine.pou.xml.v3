	fbLogger : TPL.FB_Logger;
	
	(* OnlineChange related variables *)
	fbDetectOnlineChange        : TPL.FB_DetectOnlineChange;
	xDetectOnlineChangeActive   : BOOL;
	xDetectOnlineChangeReady    : BOOL;
	etDetectOnlineChangeDiag    : GD.ET_Diag;
	etDetectOnlineChangeDiagExt : TPL.ET_DiagExt;
	sDetectOnlineChangeMsg      : STRING[80];
	
	(* Exception  *)
	xTestUserException1 : BOOL;
	xTestUserException2 : BOOL;
	xTestUserException3 : BOOL;
	xTestUserException4 : BOOL;
	xTestUserException5 : BOOL;
	
	iTemp       : INT;
	diClassTemp : DINT;
	
	sInstanceName                : STRING[80];
	diDiagClass                  : DINT;
	diDiagCode                   : DINT;
	diDiagCode_old               : DINT;
	sDiagMsg                     : STRING[40];
	sDiagMsgExt                  : STRING[15];
	xSuccess                     : BOOL;
	
	stDiagSource                 : UFMPLCI.ST_DiagSource;
	ifDriveType                  : DeviceTypeInterfaces.IF_Drive_Type;
